{
	"name": "tab-title-rules",
	"version": "0.0.1",
	"description": "Rewrites open-tab titles through a user-ordered chain of regex/backreference rules, without renaming the underlying files.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.0.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.24.0",
		"obsidian": "^1.7.2",
		"tslib": "^2.6.0",
		"typescript": "^5.7.0"
	}
}
